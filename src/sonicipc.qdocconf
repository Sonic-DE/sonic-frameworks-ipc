include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = SonicIpc
description = Framed peer-to-peer messages over local sockets

documentationinheaders = true

headerdirs += .
sourcedirs += .

outputformats = HTML

navigation.landingpage = "Sonic IPC"

depends += \
    kde \
    qtcore \
    qtnetwork

qhp.projects            = SonicIpc

qhp.SonicIpc.file                = sonicipc.qhp
qhp.SonicIpc.namespace           = org.sonicde.sonicipc.$QT_VERSION_TAG
qhp.SonicIpc.virtualFolder       = sonicipc
qhp.SonicIpc.indexTitle          = Sonic IPC
qhp.SonicIpc.indexRoot           =

qhp.SonicIpc.subprojects         = classes
qhp.SonicIpc.subprojects.classes.title = C++ Classes
qhp.SonicIpc.subprojects.classes.indexTitle = Sonic IPC C++ Classes
qhp.SonicIpc.subprojects.classes.selectors = class fake:headerfile
qhp.SonicIpc.subprojects.classes.sortPages = true

tagfile = sonicipc.tags
